# Home APM sidecar environment (BYOH mode).
# Copy to deploy/homeapm.env and fill in your Home Assistant long-lived token.
#
# In DEMO mode you do NOT create this by hand — deploy/seed-token.sh generates
# deploy/homeapm.env from .ha-runtime/token.txt.
#
# Only HA_TOKEN belongs here; HA_URL and OTLP_ENDPOINT are set on the service in
# casting.yaml / docker-compose.fallback.yml.
HA_TOKEN=paste-your-home-assistant-long-lived-access-token-here
